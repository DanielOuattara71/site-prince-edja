VITE_WEB3FORMS_ACCESS_KEY=votre-cle-web3forms
# Adresse de l'API face publique, sans barre finale. Lue par le navigateur (variable publique).
# Absente au build de production : les formulaires de contact et de collaboration restent fermés
# et l'annoncent. En développement, repli sur http://localhost:3000.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_LANGUES=fr
# Adresse des visuels sur Cloudinary (sans barre finale), p. ex.
#   PUBLIC_IMAGES_BASE_URL=https://res.cloudinary.com/VOTRE-CLOUD/image/upload/prince-edja/site
# Absente : les images de `public/images/` sont servies en local (développement et build par défaut).
# Le jour de la mise en ligne : `node scripts/pousser-images-cloudinary.mjs` pousse le dossier sur le CDN.
# PUBLIC_IMAGES_BASE_URL=
